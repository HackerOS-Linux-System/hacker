[package]
-> name        => hacker
-> version     => 0.1.0
-> description => Parser for .hacker files (v1 / v2 / v3), written in pure H#
-> authors     => ["HackerOS Team <hackeros068@gmail.com>"]
-> license     => MIT
-> lang        => h#

[edition]
-> edition => 2026

[layout]
-> src => src

[build]
-> link => static

[lib]
-> output => hlib

[default-build]
-> profile => release

[dependencies]

[commands]
-> test
--> run => bit test
--> description => Run the #[test] functions of src/lib.h#
