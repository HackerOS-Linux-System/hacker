fn test_missing_brackets() is
    match parse("hello") is
        option::Result::Ok(_) => is test::fail("expected MissingBrackets") end
        option::Result::Err(e) => is
            assert_eq(error_message(e), "Plik musi zaczynać się od '[' i kończyć ']'")
        end
    end
end

