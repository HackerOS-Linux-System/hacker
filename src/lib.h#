;; Human-readable text of an error (Rust: `impl Display for ParseError`).
;; The messages are the same Polish strings as in the Rust crate.
pub fn error_message(e: ParseError) -> string is
    match e is
        ParseError::MissingBrackets  => is return "Plik musi zaczynać się od '[' i kończyć ']'" end
        ParseError::EmptyContent     => is return "Zawartość między nawiasami jest pusta" end
        ParseError::V2ParseError(m)  => is return "Błąd parsowania v2: " + m end
        ParseError::V3ParseError(m)  => is return "Błąd parsowania v3: " + m end
        ParseError::UnknownFormat    => is return "Nieznany format pliku .hacker" end
        ParseError::IoError(m)       => is return "Błąd I/O: " + m end
    end
end

fn v2_err(msg: string) -> option::Result<HackerV2, ParseError> is
    return option::Result::Err(ParseError::V2ParseError(msg))
end

fn v3_err(msg: string) -> option::Result<HackerV3, ParseError> is
    return option::Result::Err(ParseError::V3ParseError(msg))
end

;; ═══════════════════════════════════════════════════════════════════════
;; Parsing
;; ═══════════════════════════════════════════════════════════════════════

;; v2: the text between the brackets is a header (every line up to the first
;; line ending with `:`) followed by `name:` sections holding `= value` lines.
fn parse_v2(content: string) -> option::Result<HackerV2, ParseError> is
    let lines: [string] = content_lines(content)
    if lines.len() == 0 is return v2_err("Brak linii") end

    ;; header: everything before the first `name:` line
    let mut header_lines: [string] = []
    let mut i: int = 0
    while i < lines.len() is
        let line: string = lines[i]
        if has_suffix(line, ":") is break end
        if has_prefix(line, "= ") is
            return v2_err("Wartość sekcji przed pierwszym nagłówkiem sekcji")
        end
        header_lines.push(line)
        i += 1
    end
    let header: string = join_lines(header_lines)

    ;; sections. A section only exists once it has its first value, so the
    ;; values are collected as flat (section index, value) pairs.
    let mut names: [string] = []
    let mut entry_sec: [int] = []
    let mut entry_val: [string] = []
    let mut current: string = ""
    let mut has_current: bool = false

    while i < lines.len() is
        let line: string = lines[i]
        if has_suffix(line, ":") is
            let section_name: string = trim_str(line[0..line.len() - 1])
            if section_name.len() == 0 is return v2_err("Pusta nazwa sekcji") end
            current = section_name
            has_current = true
        elsif has_prefix(line, "= ") is
            let value: string = trim_str(line[2..line.len()])
            if !has_current is return v2_err("Wartość poza sekcją") end
            let mut idx: int = index_of_name(names, current)
            if idx < 0 is
                names.push(current)
                idx = names.len() - 1
            end
            entry_sec.push(idx)
            entry_val.push(value)
        else is
            return v2_err("Nieoczekiwana linia: " + line)
        end
        i += 1
    end

    if names.len() == 0 is return v2_err("Brak sekcji w pliku v2") end

    let mut sections: [Section] = []
    let mut k: int = 0
    while k < names.len() is
        let mut vals: [string] = []
        let mut j: int = 0
        while j < entry_val.len() is
            if entry_sec[j] == k is vals.push(entry_val[j]) end
            j += 1
        end
        sections.push(Section { name: names[k], values: vals })
        k += 1
    end

    return option::Result::Ok(HackerV2 { header: header, sections: sections })
end

;; v3: exactly one each of `= header`, `=> type`, `-> description`, `--> file`
;; (in any order).
fn parse_v3(content: string) -> option::Result<HackerV3, ParseError> is
    let lines: [string] = content_lines(content)

    let mut has_header: bool = false
    let mut has_ty: bool = false
    let mut has_desc: bool = false
    let mut has_file: bool = false
    let mut header: string = ""
    let mut ty: string = ""
    let mut description: string = ""
    let mut file: string = ""

    for line in lines is
        if has_prefix(line, "= ") is
            if has_header is return v3_err("Powtórzony nagłówek (=)") end
            has_header = true
            header = trim_str(line[2..line.len()])
        elsif has_prefix(line, "=> ") is
            if has_ty is return v3_err("Powtórzony typ (=>)") end
            has_ty = true
            ty = trim_str(line[3..line.len()])
        elsif has_prefix(line, "-> ") is
            if has_desc is return v3_err("Powtórzony opis (->)") end
            has_desc = true
            description = trim_str(line[3..line.len()])
        elsif has_prefix(line, "--> ") is
            if has_file is return v3_err("Powtórzona ścieżka pliku (-->)") end
            has_file = true
            file = trim_str(line[4..line.len()])
        else is
            return v3_err("Nieoczekiwana linia: " + line)
        end
    end

    if !has_header is return v3_err("Brak nagłówka (= )") end
    if !has_ty is return v3_err("Brak typu (=> )") end
    if !has_desc is return v3_err("Brak opisu (-> )") end
    if !has_file is return v3_err("Brak ścieżki pliku (--> )") end

    return option::Result::Ok(HackerV3 { header: header, ty: ty, description: description, file: file })
end

;; Parses a string as a `.hacker` file and detects the version on its own
;; (v2, then v3, then v1 as the always-accepting fallback). The only errors
;; are `MissingBrackets` and `EmptyContent`.
pub fn parse(input: string) -> option::Result<HackerFile, ParseError> is
    let trimmed: string = trim_str(input)
    if !has_prefix(trimmed, "[") || !has_suffix(trimmed, "]") is
        return option::Result::Err(ParseError::MissingBrackets)
    end
    let content: string = trim_str(trimmed[1..trimmed.len() - 1])
    if content.len() == 0 is
        return option::Result::Err(ParseError::EmptyContent)
    end

    match parse_v2(content) is
        option::Result::Ok(v2) => is
            let f2: HackerFile = HackerFile::V2(v2)
            return option::Result::Ok(f2)
        end
        option::Result::Err(_) => is end
    end

    match parse_v3(content) is
        option::Result::Ok(v3) => is
            let f3: HackerFile = HackerFile::V3(v3)
            return option::Result::Ok(f3)
        end
        option::Result::Err(_) => is end
    end

    let f1: HackerFile = HackerFile::V1(HackerV1 { content: content })
    return option::Result::Ok(f1)
end

;; Reads and parses the file at `path`. A file that cannot be read gives
;; `ParseError::IoError`.
pub fn parse_file(path: string) -> option::Result<HackerFile, ParseError> is
    if !fs::is_file(path) is
        return option::Result::Err(ParseError::IoError("nie można odczytać pliku: " + path))
    end
    return parse(fs::read(path))
end

;; ═══════════════════════════════════════════════════════════════════════
;; Accessors
;;
;; Same names as the old Rust-backed binding, but they take a `HackerFile`
;; instead of an int handle. Asking a file for a field of another version
;; gives "" / 0 / an empty array — never an error.
;; ═══════════════════════════════════════════════════════════════════════

;; 1, 2 or 3 — the version of the file.
pub fn version(f: HackerFile) -> int is
    match f is
        HackerFile::V1(_) => is return 1 end
        HackerFile::V2(_) => is return 2 end
        HackerFile::V3(_) => is return 3 end
    end
end

pub fn is_v1(f: HackerFile) -> bool is
    return version(f) == 1
end

pub fn is_v2(f: HackerFile) -> bool is
    return version(f) == 2
end

pub fn is_v3(f: HackerFile) -> bool is
    return version(f) == 3
end

;; ── v1 ───────────────────────────────────────────────────────────────────

;; The text between `[` and `]`, trimmed. "" for other versions.
pub fn v1_content(f: HackerFile) -> string is
    match f is
        HackerFile::V1(v) => is return v.content end
        HackerFile::V2(_) => is return "" end
        HackerFile::V3(_) => is return "" end
    end
end

;; ── v2 ───────────────────────────────────────────────────────────────────

;; The header text (lines before the first section, joined with \n).
;; "" for other versions.
pub fn v2_header(f: HackerFile) -> string is
    match f is
        HackerFile::V1(_) => is return "" end
        HackerFile::V2(v) => is return v.header end
        HackerFile::V3(_) => is return "" end
    end
end

;; The sections in order of first appearance. Empty for other versions.
pub fn v2_sections(f: HackerFile) -> [Section] is
    let mut out: [Section] = []
    match f is
        HackerFile::V1(_) => is end
        HackerFile::V2(v) => is out = v.sections end
        HackerFile::V3(_) => is end
    end
    return out
end

;; Number of distinct sections.
pub fn v2_section_count(f: HackerFile) -> int is
    let secs: [Section] = v2_sections(f)
    return secs.len()
end

;; All section names, sorted alphabetically — a stable order, like the old
;; binding's `v2_section_names`.
pub fn v2_section_names(f: HackerFile) -> [string] is
    let secs: [Section] = v2_sections(f)
    let mut out: [string] = []
    for s in secs is out.push(s.name) end
    if out.len() < 2 is return out end
    return sort::sort_strings(out)
end

;; The `index`-th section name in sorted order ("" when out of range).
pub fn v2_section_name(f: HackerFile, index: int) -> string is
    let names: [string] = v2_section_names(f)
    if index < 0 || index >= names.len() is return "" end
    return names[index]
end

;; True if the file has a section called `name`.
pub fn v2_has_section(f: HackerFile, name: string) -> bool is
    let secs: [Section] = v2_sections(f)
    for s in secs is
        if s.name == name is return true end
    end
    return false
end

;; The values of section `name` in file order (empty if there is no such section).
pub fn v2_values(f: HackerFile, name: string) -> [string] is
    let secs: [Section] = v2_sections(f)
    let mut out: [string] = []
    for s in secs is
        if s.name == name is out = s.values end
    end
    return out
end

;; Number of `= value` entries under section `name`.
pub fn v2_value_count(f: HackerFile, name: string) -> int is
    let vals: [string] = v2_values(f, name)
    return vals.len()
end

;; The value at `index` under section `name` ("" when out of range).
pub fn v2_value_at(f: HackerFile, name: string, index: int) -> string is
    let vals: [string] = v2_values(f, name)
    if index < 0 || index >= vals.len() is return "" end
    return vals[index]
end

;; ── v3 ───────────────────────────────────────────────────────────────────

;; The `= header` field. "" for other versions.
pub fn v3_header(f: HackerFile) -> string is
    match f is
        HackerFile::V1(_) => is return "" end
        HackerFile::V2(_) => is return "" end
        HackerFile::V3(v) => is return v.header end
    end
end

;; The `=> type` field. "" for other versions.
pub fn v3_type(f: HackerFile) -> string is
    match f is
        HackerFile::V1(_) => is return "" end
        HackerFile::V2(_) => is return "" end
        HackerFile::V3(v) => is return v.ty end
    end
end

;; The `-> description` field. "" for other versions.
pub fn v3_description(f: HackerFile) -> string is
    match f is
        HackerFile::V1(_) => is return "" end
        HackerFile::V2(_) => is return "" end
        HackerFile::V3(v) => is return v.description end
    end
end

;; The `--> file` field. "" for other versions.
pub fn v3_file(f: HackerFile) -> string is
    match f is
        HackerFile::V1(_) => is return "" end
        HackerFile::V2(_) => is return "" end
        HackerFile::V3(v) => is return v.file end
    end
end

