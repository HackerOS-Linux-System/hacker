#[test]
fn test_v2_section_names_sorted() is
    match parse("[\nH\nzeta:\n= 1\nalfa:\n= 2\nmika:\n= 3\n]") is
        option::Result::Ok(f) => is
            assert_eq(v2_section_count(f), 3)
            assert_eq(v2_section_name(f, 0), "alfa")
            assert_eq(v2_section_name(f, 1), "mika")
            assert_eq(v2_section_name(f, 2), "zeta")
            assert_eq(v2_section_name(f, 3), "")
            assert_eq(v2_section_name(f, -1), "")
            let names: [string] = v2_section_names(f)
            assert_eq(names.len(), 3)
            assert_eq(names[0], "alfa")
        end
        option::Result::Err(_) => is test::fail("parse failed") end
    end
end

