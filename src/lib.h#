#[test]
fn test_v1_simple() is
    match parse("[ 0.1 ]") is
        option::Result::Ok(f) => is
            assert_eq(version(f), 1)
            assert_eq(v1_content(f), "0.1")
        end
        option::Result::Err(_) => is test::fail("parse failed") end
    end
end

#[test]
fn test_v1_multiline() is
    match parse("[\n  hello\n  world\n]") is
        option::Result::Ok(f) => is
            assert_eq(version(f), 1)
            assert_eq(v1_content(f), "hello\n  world")
        end
        option::Result::Err(_) => is test::fail("parse failed") end
    end
end

#[test]
fn test_v2_full() is
    let input: string = "[ \n Przyklad\n jadro:\n = xanmod\n = liquorix\n narzedzia:\n = hpm\n = hl\n wersje:\n = 0.1\n = 0.2\n = 1.1\n]"
    match parse(input) is
        option::Result::Ok(f) => is
            assert_eq(version(f), 2)
            assert_eq(v2_header(f), "Przyklad")
            assert_eq(v2_section_count(f), 3)
            let jadro: [string] = v2_values(f, "jadro")
            assert_eq(jadro.len(), 2)
            assert_eq(jadro[0], "xanmod")
            assert_eq(jadro[1], "liquorix")
            let narzedzia: [string] = v2_values(f, "narzedzia")
            assert_eq(narzedzia.len(), 2)
            assert_eq(narzedzia[0], "hpm")
            assert_eq(narzedzia[1], "hl")
            let wersje: [string] = v2_values(f, "wersje")
            assert_eq(wersje.len(), 3)
            assert_eq(wersje[0], "0.1")
            assert_eq(wersje[1], "0.2")
            assert_eq(wersje[2], "1.1")
        end
        option::Result::Err(_) => is test::fail("parse failed") end
    end
end

#[test]
fn test_v3_full() is
    let input: string = "[ \n = application\n => gui\n -> aplication for cybersecurity\n --> main.hacker\n]"
    match parse(input) is
        option::Result::Ok(f) => is
            assert_eq(version(f), 3)
            assert_eq(v3_header(f), "application")
            assert_eq(v3_type(f), "gui")
            assert_eq(v3_description(f), "aplication for cybersecurity")
            assert_eq(v3_file(f), "main.hacker")
        end
        option::Result::Err(_) => is test::fail("parse failed") end
    end
end

