;; ═══════════════════════════════════════════════════════════════════════
;; Types
;; ═══════════════════════════════════════════════════════════════════════

;; Parse errors (Rust: `ParseError`). Use `error_message` for the text.
pub enum ParseError is
    ;; missing the opening `[` or the closing `]`
    MissingBrackets
    ;; nothing between the brackets
    EmptyContent
    ;; v2 syntax error (no header / bad section ...)
    V2ParseError(string)
    ;; v3 syntax error (missing or repeated field ...)
    V3ParseError(string)
    ;; unknown format (v1 accepts everything, kept for completeness)
    UnknownFormat
    ;; the file could not be read
    IoError(string)
end

;; v1 — free text inside the brackets.
pub struct HackerV1 is
    pub content: string
end

;; One `name:` section of a v2 file with its `= value` entries.
pub struct Section is
    pub name:   string
    pub values: [string]
end

;; v2 — header plus sections. Sections keep the order of their first
;; appearance; a section that is repeated in the file is merged into one.
pub struct HackerV2 is
    pub header:   string
    pub sections: [Section]
end

;; v3 — four fixed fields. (`type` is spelled `ty`, as in the Rust crate.)
pub struct HackerV3 is
    pub header:      string
    pub ty:          string
    pub description: string
    pub file:        string
end

;; A parsed `.hacker` file of any version (Rust: `HackerFile`).
pub enum HackerFile is
    V1(HackerV1)
    V2(HackerV2)
    V3(HackerV3)
end

;; ═══════════════════════════════════════════════════════════════════════
;; Small text helpers (they work on bytes, and every cut falls on a character
;; boundary, so UTF-8 text is never split in the middle)
;; ═══════════════════════════════════════════════════════════════════════

;; ASCII whitespace: space, \t, \n, \v, \f, \r
fn is_ws_byte(c: int) -> bool is
    return c == 32 || (c >= 9 && c <= 13)
end

;; Byte length (1..3) of the whitespace character that STARTS at byte `i`, or 0
;; when it is not whitespace. Rust's `str::trim` removes every Unicode
;; `White_Space` character, so this knows the multi-byte ones as well:
;; U+0085 U+00A0 U+1680 U+2000..U+200A U+2028 U+2029 U+202F U+205F U+3000.
fn ws_len_at(s: string, i: int) -> int is
    let n: int = s.len()
    let c: int = byte_at(s, i)
    if is_ws_byte(c) is return 1 end
    if c == 194 && i + 1 < n is
        let d: int = byte_at(s, i + 1)
        if d == 133 || d == 160 is return 2 end
        return 0
    end
    if c == 225 && i + 2 < n is
        if byte_at(s, i + 1) == 154 && byte_at(s, i + 2) == 128 is return 3 end
        return 0
    end
    if c == 226 && i + 2 < n is
        let d: int = byte_at(s, i + 1)
        let f: int = byte_at(s, i + 2)
        if d == 128 && ((f >= 128 && f <= 138) || f == 168 || f == 169 || f == 175) is return 3 end
        if d == 129 && f == 159 is return 3 end
        return 0
    end
    if c == 227 && i + 2 < n is
        if byte_at(s, i + 1) == 128 && byte_at(s, i + 2) == 128 is return 3 end
        return 0
    end
    return 0
end

;; Same, for the whitespace character that ENDS right before byte `b`
;; (`b` is an exclusive end offset, `b > 0`).
fn ws_len_ending_at(s: string, b: int) -> int is
    let c: int = byte_at(s, b - 1)
    if is_ws_byte(c) is return 1 end
    if b >= 2 && byte_at(s, b - 2) == 194 && (c == 133 || c == 160) is return 2 end
    if b >= 3 is
        let l: int = byte_at(s, b - 3)
        let m: int = byte_at(s, b - 2)
        if l == 225 && m == 154 && c == 128 is return 3 end
        if l == 226 && m == 128 && ((c >= 128 && c <= 138) || c == 168 || c == 169 || c == 175) is return 3 end
        if l == 226 && m == 129 && c == 159 is return 3 end
        if l == 227 && m == 128 && c == 128 is return 3 end
    end
    return 0
end

;; `str::trim` — strips leading and trailing Unicode whitespace.
fn trim_str(s: string) -> string is
    let n: int = s.len()
    let mut a: int = 0
    while a < n is
        let w: int = ws_len_at(s, a)
        if w == 0 is break end
        a += w
    end
    let mut b: int = n
    while b > a is
        let w: int = ws_len_ending_at(s, b)
        if w == 0 is break end
        b -= w
    end
    if a >= b is return "" end
    return s[a..b]
end

fn has_prefix(s: string, p: string) -> bool is
    return s.len() >= p.len() && s[0..p.len()] == p
end

fn has_suffix(s: string, p: string) -> bool is
    return s.len() >= p.len() && s[s.len() - p.len()..s.len()] == p
end

;; `str::lines()` — split on \n (a trailing \r is removed later by trim_str)
fn split_lines(src: string) -> [string] is
    let mut out: [string] = []
    let n: int = src.len()
    let mut pos: int = 0
    while pos < n is
        let mut e: int = pos
        while e < n && byte_at(src, e) != 10 is e += 1 end
        out.push(src[pos..e])
        pos = e + 1
    end
    return out
end

;; the trimmed, non-empty lines of `content`
fn content_lines(content: string) -> [string] is
    let raw: [string] = split_lines(content)
    let mut out: [string] = []
    for l in raw is
        let t: string = trim_str(l)
        if t.len() > 0 is out.push(t) end
    end
    return out
end

fn join_lines(parts: [string]) -> string is
    let mut out: string = ""
    let mut i: int = 0
    while i < parts.len() is
        if i > 0 is out += "\n" end
        out += parts[i]
        i += 1
    end
    return out
end

fn index_of_name(names: [string], name: string) -> int is
    let mut i: int = 0
    while i < names.len() is
        if names[i] == name is return i end
        i += 1
    end
    return -1
end

