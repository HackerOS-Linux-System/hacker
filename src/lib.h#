#[test]
fn test_v2_repeated_section_is_merged() is
    match parse("[\nH\na:\n= 1\nb:\n= x\na:\n= 2\n]") is
        option::Result::Ok(f) => is
            assert_eq(version(f), 2)
            assert_eq(v2_section_count(f), 2)
            assert_eq(v2_value_count(f, "a"), 2)
            assert_eq(v2_value_at(f, "a", 0), "1")
            assert_eq(v2_value_at(f, "a", 1), "2")
            assert_eq(v2_value_count(f, "b"), 1)
        end
        option::Result::Err(_) => is test::fail("parse failed") end
    end
end

#[test]
fn test_v2_multiline_header_and_crlf() is
    match parse("[\r\nLinia 1\r\nLinia 2\r\nsekcja:\r\n= wartosc\r\n]") is
        option::Result::Ok(f) => is
            assert_eq(version(f), 2)
            assert_eq(v2_header(f), "Linia 1\nLinia 2")
            assert_eq(v2_value_at(f, "sekcja", 0), "wartosc")
